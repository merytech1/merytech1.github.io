---
import Layout from "../layouts/Layout.astro";
import Dashboard from "./Dashboard";
import { ui, stack, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const LINKEDIN = "https://www.linkedin.com/in/meriyei-manosalva-ferrer";
const EMAIL = "meriyei.manfer@gmail.com";
const GITHUB = "https://github.com/merytech1";

const banner =
  "https://capsule-render.vercel.app/api?type=waving&color=0:7F00FF,100:FE428E&height=200&section=header&text=Meriyei%20Manosalva&fontSize=48&fontColor=ffffff&animation=fadeIn&desc=Full%20Stack%20Developer&descAlignY=72&descSize=20";
const typing = `https://readme-typing-svg.demolab.com?font=Fira+Code&weight=600&size=22&pause=1000&color=FE428E&center=true&vCenter=true&width=600&lines=${t.hero.typing}`;

const stackGroups = [
  { title: t.stack.frontend, emoji: "🎨", items: stack.frontend },
  { title: t.stack.backend, emoji: "⚙️", items: stack.backend },
  { title: t.stack.tools, emoji: "🧰", items: stack.tools },
];

const projects = [
  {
    name: "tvshields",
    emoji: "📺",
    text: t.projects.tvshields,
    tags: ["Kotlin", "Rust", "Android TV", "WebView", "Adblock"],
    repo: `${GITHUB}/tvshields`,
    demo: null,
  },
  {
    name: "EVA",
    emoji: "🌸",
    text: t.projects.eva,
    tags: ["React", "TypeScript", "FastAPI", "PostgreSQL", "ML", "PWA"],
    repo: `${GITHUB}/EVA`,
    demo: "https://eva-olive-one.vercel.app",
  },
];

const navLinks = [
  ["#about", t.nav.about],
  ["#stack", t.nav.stack],
  ["#projects", t.nav.projects],
  ["#dashboard", t.nav.dashboard],
  ["#contact", t.nav.contact],
];
---

<Layout lang={lang}>
  <header class="nav">
    <div class="container nav-inner">
      <a class="logo" href={lang === "es" ? "/" : "/en/"}>merytech1<span>_</span></a>
      <nav aria-label="Main">
        <ul class="nav-links">
          {navLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <div class="lang-switch" role="group" aria-label="Idioma / Language">
        <a href="/" aria-current={lang === "es" ? "true" : undefined} lang="es">ES</a>
        <a href="/en/" aria-current={lang === "en" ? "true" : undefined} lang="en">EN</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Contact banner, same as the GitHub profile README -->
    <section class="hero">
      <img class="banner" src={banner} alt="Meriyei Manosalva · Full Stack Developer" width="1200" height="200" />
      <div class="container">
        <img class="typing" src={typing} alt="Full Stack Developer · React · TypeScript · Python · FastAPI" width="600" height="50" />
        <div class="badges">
          <a href={LINKEDIN} target="_blank" rel="noopener"><img src="https://img.shields.io/badge/LinkedIn-0A66C2?style=for-the-badge&logo=linkedin&logoColor=white" alt="LinkedIn" height="28" /></a>
          <a href={`mailto:${EMAIL}`}><img src="https://img.shields.io/badge/Email-FE428E?style=for-the-badge&logo=gmail&logoColor=white" alt="Email" height="28" /></a>
          <a href={GITHUB} target="_blank" rel="noopener"><img src="https://img.shields.io/badge/GitHub-181717?style=for-the-badge&logo=github&logoColor=white" alt="GitHub" height="28" /></a>
          <a href={GITHUB} target="_blank" rel="noopener"><img src="https://komarev.com/ghpvc/?username=merytech1&style=for-the-badge&color=blueviolet&label=Visitas" alt="Visitas" height="28" /></a>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <h2 class="section-title">{t.about.title}</h2>
        <ul class="about card">
          {t.about.items.map(([emoji, text]) => (
            <li><span class="emoji" aria-hidden="true">{emoji}</span><span>{text}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="stack">
      <div class="container">
        <h2 class="section-title">{t.stack.title}</h2>
        <div class="stack-grid">
          {stackGroups.map((group) => (
            <div class="card stack-group">
              <h3><span aria-hidden="true">{group.emoji}</span> {group.title}</h3>
              <ul class="icons">
                {group.items.map(([id, name, url]) => (
                  <li>
                    <a href={url} target="_blank" rel="noopener" title={name}>
                      <img src={`https://skillicons.dev/icons?i=${id}&theme=dark`} alt={name} width="48" height="48" loading="lazy" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <h2 class="section-title">{t.projects.title}</h2>
        <div class="projects">
          {projects.map((p) => (
            <article class="card project">
              <div class="project-head">
                <span class="project-emoji" aria-hidden="true">{p.emoji}</span>
                <h3>{p.name}</h3>
              </div>
              <p>{p.text}</p>
              <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
              <div class="project-links">
                <a class="btn" href={p.repo} target="_blank" rel="noopener">{t.projects.repo} ↗</a>
                {p.demo && <a class="btn btn-primary" href={p.demo} target="_blank" rel="noopener">{t.projects.demo} ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="dashboard">
      <div class="container">
        <h2 class="section-title">{t.dashboard.title}</h2>
        <p class="lead">{t.dashboard.subtitle}</p>
        <Dashboard client:visible strings={t.dashboard} />
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <h2 class="section-title">{t.contact.title}</h2>
        <div class="card contact">
          <p>{t.contact.text}</p>
          <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <div class="badges">
            <a href={LINKEDIN} target="_blank" rel="noopener"><img src="https://img.shields.io/badge/LinkedIn-0A66C2?style=for-the-badge&logo=linkedin&logoColor=white" alt="LinkedIn" height="28" /></a>
            <a href={`mailto:${EMAIL}`}><img src="https://img.shields.io/badge/Email-FE428E?style=for-the-badge&logo=gmail&logoColor=white" alt="Email" height="28" /></a>
            <a href={GITHUB} target="_blank" rel="noopener"><img src="https://img.shields.io/badge/GitHub-181717?style=for-the-badge&logo=github&logoColor=white" alt="GitHub" height="28" /></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <img class="footer-wave" src="https://capsule-render.vercel.app/api?type=waving&color=0:FE428E,100:7F00FF&height=100&section=footer" alt="" width="1200" height="100" />
    <p class="container">© {new Date().getFullYear()} Meriyei Manosalva · {t.footer}</p>
  </footer>
</Layout>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .logo {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--text);
    font-size: 1.1rem;
  }
  .logo span {
    color: var(--pink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  nav {
    margin-left: auto;
  }
  .nav-links {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .lang-switch {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .lang-switch a {
    padding: 4px 10px;
    color: var(--muted);
  }
  .lang-switch a[aria-current] {
    background: var(--pink);
    color: #fff;
  }
  @media (max-width: 760px) {
    nav { display: none; }
    .lang-switch { margin-left: auto; }
  }

  .hero {
    padding: 0 0 8px;
  }
  .banner {
    width: 100%;
    height: auto;
  }
  .typing {
    margin: 8px auto 20px;
    height: auto;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badges img {
    height: 28px;
    width: auto;
  }

  .about {
    list-style: none;
    margin: 0;
    padding: 24px;
    display: grid;
    gap: 14px;
  }
  .about li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 1.05rem;
  }
  .emoji {
    font-size: 1.3rem;
    line-height: 1.4;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .stack-group {
    padding: 20px;
  }
  .stack-group h3 {
    margin: 0 0 14px;
    font-size: 1rem;
    color: var(--muted);
    font-weight: 500;
  }
  .icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .icons a {
    display: block;
    transition: transform 0.2s ease;
  }
  .icons a:hover {
    transform: translateY(-3px);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 16px;
  }
  .project {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .project:hover {
    border-color: var(--pink);
    transform: translateY(-2px);
  }
  .project-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .project-head h3 {
    margin: 0;
    font-family: var(--mono);
    font-size: 1.35rem;
  }
  .project-emoji {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--purple), var(--pink));
    font-size: 1.3rem;
  }
  .project p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-family: var(--mono);
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--cyan);
  }
  .project-links {
    display: flex;
    gap: 10px;
  }
  .btn {
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .btn:hover {
    border-color: var(--pink);
    color: var(--text);
  }
  .btn-primary {
    background: var(--pink);
    border-color: var(--pink);
    color: #fff;
  }
  .btn-primary:hover {
    color: #fff;
    filter: brightness(1.1);
  }

  .lead {
    color: var(--muted);
    margin: -16px 0 24px;
  }

  .contact {
    padding: 32px 24px;
    text-align: center;
    display: grid;
    gap: 14px;
    justify-items: center;
  }
  .contact p {
    margin: 0;
    font-size: 1.1rem;
  }
  .email {
    font-family: var(--mono);
    font-size: clamp(1rem, 3vw, 1.3rem);
    color: var(--pink);
    word-break: break-all;
  }

  footer {
    margin-top: 48px;
  }
  .footer-wave {
    width: 100%;
    height: auto;
  }
  footer p {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    padding-top: 12px;
    padding-bottom: 24px;
    margin: 0;
  }
</style>
